{
  "name": "flowpilot-ai",
  "version": "1.0.0",
  "private": true,
  "description": "FlowPilot AI - AI-Powered Business Operations & Workflow Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"blue.bold,cyan.bold\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"API,WEB,WORKER\" -c \"blue.bold,cyan.bold,magenta.bold\" \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:seed": "npm run seed --workspace=apps/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
