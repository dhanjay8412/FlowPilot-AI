# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/flowpilot_ai

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-cookie-key-flowpilot-2026
SESSION_SECRET=flowpilot-session-secret-key-32-chars-long

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ENABLE_MOCK_AI=false

# Rate Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE_BYTES=10485760

# Background Worker & Cron
WORKER_ENABLED=true
DAILY_REPORT_CRON=0 0 * * *
